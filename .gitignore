# Regenerable Stage-1 outputs (run: python -m src.preprocess --country <ISO3>)
data/intermediate/

# All Stage-2 outputs: experiment archives (.tar.gz), per-combo Sobol/feature
# CSVs, figures and the run/convergence JSONL logs. Large and fully regenerable
# (python -m src.run_experiments / run_study.py), so the whole folder is ignored
# - it was 5k+ files. The aggregated summary workbook lives at the repo root.
results/

# Overview / summary figures (regenerable from the summary workbook)
overview_figures/

# Protection-gap investigation: interactive map (FLOPROS tiles, ~15k files),
# figures and the gap-asset table. Local only and regenerable from its scripts/.
protection_gaps/

# Sobol convergence outputs (src.convergence_tests, src.plan_convergence_reruns).
# The bootstrap CSVs (~9 MB, rewritten on every retest) and the dated rerun
# plans are regenerable; the two workbooks are tracked, like the summary one.
convergence/*
!convergence/sobol_convergence.xlsx
!convergence/screening_factors.xlsx

# SLURM job logs written to the repo root (e.g. conv_retry_<jobid>.out/.err)
/*.out
/*.err

# Country boundary cache, downloaded on first run of src/plot_maps.py.
# It lives here rather than under data/ because data/ is read-only.
geo/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Local agent / IDE config, not project content
.claude/
.vscode/

# OS cruft
Thumbs.db
.DS_Store

# Generated combo lists and local working notes. Everything .txt is scratch by
# default; the four the project actually needs are negated below - add a "!"
# line here if a new tracked .txt is ever introduced, or git will ignore it.
*.txt
!requirements.txt
!coastal_rerun.txt
!failed_combos.txt
!finished_combos.txt

# Word documents: local working drafts, such as the DamageScanner bug report
# whose content now lives in the upstream issues. Binary, so they cannot be
# diffed or reviewed - keep them out of the repo. Note this is NOT extended to
# .xlsx: the summary workbook at the repo root is tracked on purpose.
*.docx

*.egg-info/

# Pre-rerun snapshots of derived per-combination results, and the retry
# lists generated from the convergence log. Both are reproducible.
results_snapshot_*/
sobol_retry/
